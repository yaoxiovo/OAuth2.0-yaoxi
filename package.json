{
  "name": "yaoxi-account",
  "version": "1.0.0",
  "description": "Production SSO Gateway & Identity Auth System for yaoxi.cloud and yaoxi.wiki",
  "main": "accounts-login.js",
  "engines": { "node": ">=22.13.0 <23" },
  "scripts": {
    "start": "node --experimental-default-type=module server/main.mjs",
    "build": "node build.js",
    "test": "npm run test:enforcement && npm run test:server",
    "prepush": "node build.js",
    "test:enforcement": "node --experimental-default-type=module --test test/enforcement.test.mjs test/sdk-revocation.test.mjs",
    "test:server": "node --experimental-default-type=module --test test/server.test.mjs"
  },
  "keywords": [
    "sso",
    "oauth2",
    "passkey",
    "webauthn",
    "google-identity",
    "nodejs",
    "sqlite"
  ],
  "author": "yaoxi",
  "license": "MIT"
}
